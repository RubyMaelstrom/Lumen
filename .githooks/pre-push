#!/usr/bin/env bash
#
# Pre-push: everything in the workspace must still compile before anything leaves this machine.
# The engine is gated per-architecture (jit.rs is aarch64-gated with an x86-64 fallback), so a
# native run on one host happily passes while a bytecode/interpreter change breaks another tier.
# `--all-targets` includes tests, benches and examples, where that kind of rot usually hides.
#
# This deliberately does NOT install toolchains or targets. Cross-target checks (wasm32, other
# architectures) belong in CI or in an explicit manual build, not in a hook that mutates the
# local toolchain on every push.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip in an emergency:    git push --no-verify
set -euo pipefail

echo "pre-push: cargo check --workspace --all-targets ..." >&2
cargo check -q --workspace --all-targets
echo "pre-push: workspace check OK" >&2
